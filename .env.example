# Database Type: 'supabase' or 'sqlite'
DB_TYPE=supabase

# Supabase Configurations
SUPABASE_URL=https://your-project-id.supabase.co

# Use your publishable key (anon key) or secret key (service role key).
# Note: If using the publishable key, enable public policies in your Supabase DB.
SUPABASE_KEY=your-supabase-key
